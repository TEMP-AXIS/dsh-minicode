{
  "name": "dsh-minicode",
  "version": "0.5.0",
  "description": "MiniWorld (迷你世界) UGC wiki as a local index for DeepSeek Harness. Twelve agent tools answer API, event, enum, doc and id lookups from a bundled index in a few hundred tokens. The index and the ~26.5k-name id tables ship inside the plugin: nothing is fetched, crawled or opened at runtime.",
  "type": "module",
  "engines": {
    "node": "^22.15.0 || >=24.0.0"
  },
  "main": "./index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TEMP-AXIS/dsh-minicode.git"
  },
  "homepage": "https://github.com/TEMP-AXIS/dsh-minicode#readme",
  "bugs": {
    "url": "https://github.com/TEMP-AXIS/dsh-minicode/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "builtin/",
    "data/",
    "scripts/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build.mjs --offline",
    "test": "node scripts/check-contrib.mjs && node scripts/_smoke.mjs",
    "check:contrib": "node scripts/check-contrib.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "miniworld",
    "ugc",
    "wiki",
    "minicode",
    "lua"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
